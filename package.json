{
    "name": "nathans-portfolio-website",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev --turbopack",
        "prebuild": "node scripts/nodefarm/stamp-art.mjs --check",
        "build": "next build",
        "test:nodefarm": "node --experimental-strip-types --no-warnings --test --test-reporter=spec \"tests/nodefarm/*.test.mjs\" \"tests/games/*.test.mjs\" \"tests/automation/*.test.mjs\" \"tests/starwright/*.test.mjs\" \"tests/groundbreak/*.test.mjs\" \"tests/saves/*.test.mjs\"",
        "test:automation": "node --experimental-strip-types --no-warnings --test --test-reporter=spec \"tests/automation/*.test.mjs\"",
        "test:automation:browser": "node tests/automation/browser/run.mjs",
        "start": "next start",
        "test:shell": "node scripts/ci/checks/run.mjs shell",
        "test:window": "node scripts/ci/checks/run.mjs window",
        "test:hud": "node scripts/ci/checks/run.mjs hud",
        "check:games": "node scripts/ci/checks/run.mjs all",
        "new-game": "node scripts/games/new-game.mjs",
        "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
        "check:automation": "node --experimental-strip-types --no-warnings scripts/automation/check-recipes.mjs"
    },
    "dependencies": {
        "@supabase/supabase-js": "^2.117.2",
        "clsx": "^2.1.1",
        "d3-geo": "^3.1.1",
        "next": "^16.3.6",
        "next-themes": "^0.4.6",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "tailwind-merge": "^3.0.2",
        "three": "0.186.1",
        "topojson-client": "^3.1.0"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4",
        "@types/d3-geo": "^3.1.1",
        "@types/geojson": "^7946.0.16",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@types/three": "0.186.0",
        "@types/topojson-client": "^3.1.5",
        "@types/topojson-server": "^3.0.4",
        "@types/topojson-simplify": "^3.0.3",
        "@types/topojson-specification": "^1.0.5",
        "flag-icons": "^7.5.0",
        "prettier": "^3.5.3",
        "tailwindcss": "^4",
        "topojson-server": "^3.0.1",
        "topojson-simplify": "^3.0.3",
        "typescript": "^5"
    }
}
